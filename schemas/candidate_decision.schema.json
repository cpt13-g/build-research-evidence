{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate decision",
  "type": "object",
  "required": ["schema_version", "candidate_decision"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "candidate_decision": {
      "type": "object",
      "required": ["decision_id", "design_envelope_id", "selected", "reserve", "rejected", "comparison_dimensions", "rationale", "metric_tradeoff", "scientific_tradeoff", "next_action"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^CD-[A-Za-z0-9_-]+$"},
        "design_envelope_id": {"type": "string", "minLength": 1},
        "selected": {"type": "array", "minItems": 1},
        "reserve": {"type": "array"},
        "rejected": {"type": "array"},
        "comparison_dimensions": {"type": "object", "required": ["task_performance", "claim_alignment", "scientific_interpretability", "evidence_strength", "stability", "complexity", "compute_cost", "implementation_risk"]},
        "rationale": {"type": "string", "minLength": 1},
        "metric_tradeoff": {"type": "string", "minLength": 1},
        "scientific_tradeoff": {"type": "string", "minLength": 1},
        "next_action": {"enum": ["FULL_EVALUATION", "RUN_DIAGNOSTIC", "REOPEN_SEARCH", "STOP"]}
      }
    }
  },
  "additionalProperties": true
}

