{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment contract",
  "type": "object",
  "required": ["schema_version", "contract"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract": {
      "type": "object",
      "required": ["version", "status", "research_spine_revision", "claims", "evidence_questions", "datasets", "data_splits", "baselines", "primary_metrics", "secondary_metrics", "seed_protocol", "statistical_protocol", "fairness_rules", "compute_environment", "execution_policy", "budget", "priorities", "stop_conditions", "method_policy", "approval"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "approved", "superseded"]},
        "research_spine_revision": {"type": "integer", "minimum": 0},
        "claims": {"type": "array"},
        "evidence_questions": {"type": "array"},
        "datasets": {"type": "array"},
        "data_splits": {"type": "array"},
        "baselines": {"type": "array"},
        "primary_metrics": {"type": "array"},
        "secondary_metrics": {"type": "array"},
        "seed_protocol": {"type": "object", "required": ["seeds", "na_reason"]},
        "statistical_protocol": {"type": "object"},
        "fairness_rules": {"type": "array"},
        "compute_environment": {"type": "object"},
        "execution_policy": {"type": "object"},
        "budget": {"type": "object"},
        "priorities": {"type": "object"},
        "stop_conditions": {"type": "array"},
        "method_policy": {
          "type": "object",
          "required": ["structure_frozen", "allowed_via_design_iteration", "frozen_l1_elements", "adaptive_l2_elements", "free_l3_elements"],
          "properties": {
            "structure_frozen": {"const": false},
            "allowed_via_design_iteration": {"const": true},
            "frozen_l1_elements": {"type": "array", "minItems": 1},
            "adaptive_l2_elements": {"type": "array", "minItems": 1},
            "free_l3_elements": {"type": "array", "minItems": 1}
          }
        },
        "approval": {"type": "object", "required": ["gate", "status"]}
      }
    }
  },
  "additionalProperties": true
}
