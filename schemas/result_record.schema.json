{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audited result record",
  "type": "object",
  "required": ["schema_version", "result"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "result": {
      "type": "object",
      "required": ["record_id", "experiment_id", "card_revision", "run_id", "execution", "metrics", "artifacts", "evidence_classification", "audit"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "experiment_id": {"pattern": "^[ET][0-9]{4}$"},
        "card_revision": {"type": "integer", "minimum": 1},
        "run_id": {"type": "string", "minLength": 1},
        "execution": {"type": "object", "required": ["status", "started_at", "ended_at", "exit_code", "command", "run_manifest_path", "environment_path", "log_path"]},
        "metrics": {"type": "object"},
        "artifacts": {"type": "array"},
        "evidence_classification": {"enum": ["FORMAL_CLAIM_EVIDENCE", "PRELIMINARY_NON_PAPER"]},
        "audit": {
          "type": "object",
          "required": ["independence", "result_type", "validity", "performance_value", "scientific_value", "claim_impact", "confidence", "confounders", "recommended_next_action", "diagnosis", "audited_at"],
          "properties": {
            "independence": {
              "type": "object",
              "required": ["first_pass_mode", "planner_interpretation_seen_before_verdict", "raw_evidence_reviewed", "inputs_reviewed", "deterministic_checks", "exception_reason"],
              "properties": {
                "first_pass_mode": {"enum": ["BLIND_FIRST_PASS", "FULL_CONTEXT_EXCEPTION"]},
                "planner_interpretation_seen_before_verdict": {"type": "boolean"},
                "raw_evidence_reviewed": {"const": true},
                "inputs_reviewed": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
                "deterministic_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "exception_reason": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            },
            "result_type": {"enum": ["SUPPORTING", "FALSIFYING", "BOUNDARY", "NULL", "CONFOUNDING", "IMPLEMENTATION_FAILURE", "INCONCLUSIVE"]},
            "validity": {"enum": ["valid", "invalid", "uncertain"]},
            "performance_value": {"type": "string", "minLength": 1},
            "scientific_value": {"type": "string", "minLength": 1},
            "claim_impact": {"type": "object"},
            "confidence": {"enum": ["low", "medium", "high"]},
            "confounders": {"type": "array"},
            "recommended_next_action": {"type": "string", "minLength": 1},
            "diagnosis": {
              "type": "object",
              "required": ["diagnosis_id", "result_type", "experiment_validity", "convergence_status", "baseline_fairness", "primary_observation", "claim_impact", "performance_value", "scientific_value", "confidence", "suspected_causes", "unresolved_confounders", "failure_level", "recommended_action"],
              "properties": {
                "diagnosis_id": {"type": "string", "minLength": 1},
                "result_type": {"enum": ["SUPPORTING", "FALSIFYING", "BOUNDARY", "NULL", "CONFOUNDING", "IMPLEMENTATION_FAILURE", "INCONCLUSIVE"]},
                "experiment_validity": {"enum": ["valid", "invalid", "uncertain"]},
                "convergence_status": {"enum": ["converged", "not_converged", "unstable", "unknown", "not_applicable"]},
                "baseline_fairness": {"enum": ["fair", "unfair", "uncertain", "not_applicable"]},
                "primary_observation": {"type": "string", "minLength": 1},
                "claim_impact": {"type": "object"},
                "performance_value": {"type": "string", "minLength": 1},
                "scientific_value": {"type": "string", "minLength": 1},
                "confidence": {"enum": ["low", "medium", "high"]},
                "suspected_causes": {"type": "array"},
                "unresolved_confounders": {"type": "array"},
                "failure_level": {"enum": ["NONE", "F1_EXECUTION", "F2_METHOD", "F3_HYPOTHESIS_RISK"]},
                "recommended_action": {"enum": ["ACCEPT", "FULL_EVALUATION", "DEBUG", "TUNE", "RUN_DIAGNOSTIC", "REFINE_METHOD", "REJECT_CANDIDATE", "KEEP_AS_BOUNDARY_EVIDENCE", "ESCALATE_HYPOTHESIS_RISK", "STOP"]}
              }
            },
            "audited_at": {"type": "string"}
          }
        }
      }
    }
  },
  "additionalProperties": true
}
