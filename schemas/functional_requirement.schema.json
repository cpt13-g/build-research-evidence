{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Functional requirement",
  "type": "object",
  "required": ["schema_version", "functional_requirement"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "functional_requirement": {
      "type": "object",
      "required": ["requirement_id", "contribution_id", "research_problem", "observed_or_expected_failure", "hypothesized_cause", "required_capability", "validation_target", "evidence_question_ids", "status"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^FR-[A-Za-z0-9_-]+$"},
        "contribution_id": {"type": "string", "minLength": 1},
        "research_problem": {"type": "string", "minLength": 1},
        "observed_or_expected_failure": {"type": "string", "minLength": 1},
        "hypothesized_cause": {"type": "string", "minLength": 1},
        "required_capability": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "validation_target": {"type": "array", "minItems": 1},
        "evidence_question_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["draft", "active", "superseded"]}
      }
    }
  },
  "additionalProperties": true
}

