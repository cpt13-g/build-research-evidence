{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuning card",
  "type": "object",
  "required": ["schema_version", "tuning"],
  "properties": {"schema_version": {"const": "1.0"}, "tuning": {"type": "object", "required": ["tuning_id", "card_revision", "status", "purpose", "unblocks_experiment", "changed_parameters", "controlled_variables", "search_bounds", "selection_rule", "estimated_budget", "stop_condition", "claim_evidence_eligible", "approval"], "properties": {"tuning_id": {"pattern": "^T[0-9]{4}$"}, "card_revision": {"type": "integer", "minimum": 1}, "status": {"enum": ["draft", "approved", "running", "completed", "failed", "audited"]}, "purpose": {"type": "string", "minLength": 1}, "unblocks_experiment": {"type": ["string", "null"], "pattern": "^E[0-9]{4}$"}, "changed_parameters": {"type": "array", "minItems": 1}, "controlled_variables": {"type": "array"}, "search_bounds": {"type": "object"}, "selection_rule": {"type": "string", "minLength": 1}, "estimated_budget": {"type": "object", "minProperties": 1}, "stop_condition": {"type": "string", "minLength": 1}, "claim_evidence_eligible": {"const": false}, "approval": {"type": "object", "required": ["approved_by", "approved_at"]}}}},
  "additionalProperties": true
}

